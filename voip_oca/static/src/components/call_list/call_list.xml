<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voip_oca.CallList">
        <t t-foreach="this.props.records" t-as="call" t-key="call.id">
            <div
                class="o_voip_call_item d-flex flex-column p-3 cursor-pointer"
                t-on-click="() => this.onClick(call)"
            >
                <span class="fw-bold" t-out="call.partner[1]" />
                <span t-out="call.display_name" />
                <div class="small text-muted">
                    <t t-out="call.dateStr" />
                    <t t-if="call.duration"> • <t t-out="call.durationStr" />
                    </t>
                </div>
            </div>
        </t>
    </t>
</templates>
